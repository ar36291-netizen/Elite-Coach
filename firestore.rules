rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helper Check
    function isSignedIn() {
      return request.auth != null;
    }

    // Attribute check matching owner id
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Prevent ID injection / high characters
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Strict schema structure integrity check
    function isValidUser(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 256;
    }

    // Match router block for user document profiles
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      
      allow create: if isOwner(userId) && 
                      isValidId(userId) && 
                      isValidUser(request.resource.data) &&
                      request.resource.data.keys().hasAll(['uid', 'email']) &&
                      request.resource.data.keys().size() >= 2;
                      
      allow update: if isOwner(userId) && 
                      isValidId(userId) && 
                      isValidUser(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.email == resource.data.email;
                      
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
